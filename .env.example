# knives.lol — Phase 2 environment variables
# Copy to .env.local for local dev. In production these are set in Vercel.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — SERVER ONLY. Never expose to the client.
# Used for: account deletion, the import script, marking emails verified.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for OAuth + email redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
